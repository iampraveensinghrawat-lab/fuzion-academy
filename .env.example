# Fuzion Academy - Environment Variables
# Copy this to .env.local and update with your actual credentials

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini API (for AI Speaking Coach evaluation & feedback)
GEMINI_API_KEY=your-gemini-api-key-here

# Academy Information
NEXT_PUBLIC_ACADEMY_NAME="Fuzion Academy"
NEXT_PUBLIC_ACADEMY_TAGLINE="Learn English. Speak Confidently. Grow Professionally."
